	:availableDate "2023-05-09T21:07:50Z"^^xsd:dateTime ;
	:accessionedDate "2023-05-09T21:07:50Z"^^xsd:dateTime ;
	:submittedDate "2022-12-01T00:00:00Z"^^xsd:dateTime ;
