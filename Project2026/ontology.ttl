	:availableDate "2025-07-30T08:41:02Z"^^xsd:dateTime ;
	:accessionedDate "2025-07-30T08:41:02Z"^^xsd:dateTime ;
	:submittedDate "2024-07-01T00:00:00Z"^^xsd:dateTime ;
	:grade "17 valores" ;
	:rightsURI "http://creativecommons.org/licenses/by/4.0/" ;
	:hasOriginal :Jose_Pedro_Machado_Costa_pdf ;
