	:availableDate "2014-02-06T17:18:42Z"^^xsd:dateTime ;
	:accessionedDate "2014-02-06T17:18:42Z"^^xsd:dateTime ;
	:submittedDate "2013-01-01T00:00:00Z"^^xsd:dateTime ;
