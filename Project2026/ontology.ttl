	:availableDate "2024-09-12T14:45:46Z"^^xsd:dateTime ;
	:accessionedDate "2024-09-12T14:45:46Z"^^xsd:dateTime ;
	:submittedDate "2024-01-01T00:00:00Z"^^xsd:dateTime ;
